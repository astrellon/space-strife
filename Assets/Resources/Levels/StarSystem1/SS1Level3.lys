(function levelDescription()
  (return ($ "The iron rich moon of " NAMES.drewe " orbits the fast spinning gas giant " NAMES.zephyr ". It's many gravity wells from all it's siblings make navigation complicated."))
)

(function levelStart(isFirstInit)
  (if isFirstInit (
    (actor "left" { "actor" MAINCHAR "emotion" "idle" })
    (actor "right" { "actor" S "emotion" "idle" })
    (playBGM "dialogue1")

    (if (isChar A) (startAlice))
    (if (isChar B) (startBob))
    (if (isChar C) (startCaesar))
  ) (
    (startLevel)
  ))

  (playBGM "s1l3")
  (startWaves)
)

(function levelEnd ()
  (actor "left" { "actor" MAINCHAR "emotion" "idle" })
  (actor "right" { "actor" S "emotion" "idle" })
  (playBGM "win1")

  (if (isChar A) (endAlice))
  (if (isChar B) (endBob))
  (if (isChar C) (endCaesar))

  (finishLevel)
)

(function startAlice()
  (if (== PLAYCOUNTS.A 0)
  (
    (line "left" "Why are they always going after places surrounded by moons!")
    (line "right" "The more complex gravity wells provide them with cover and they know that.")
    (line "right" "Which is why you'll be driving the " NAMES.tankRocket " tank.")
    (line "left" "Ohh!")
    (line "right" "The " NAMES.tankRocket " tank is well equipped for tighter spaces where regular projectiles might get lost.")
    (startLevel)
    (line "left" "Let's do this!")
  )
  ( ; Else
    (line "left" "Okay I think I've gotten the hang of these rockets!")
    (line "right" "That's good!")
    (startLevel)
  ))
)

(function endAlice ()
  (if (== PLAYCOUNTS.A 0)
  (
    (line "left" "We did it! We saved all the planets in this star system yea?")
    (line "right" "Good job. Yes the people here can breath a little easier tonight.")
    (line "left" "Alright! So we can go rescue " C.name " right?")
    (line "right" "... I'm afraid the long range probes haven't picked up anything yet.")
    (line "left" "But we're still going right?")
    (line "right" "Yes, the " NAMES.aliens " seemed to have left the area so we're heading in for a closer look.")
    (line "left" "Please be okay " C.name "!")
  )
  ( ; Else
    (line "left" "We did it!")
    (line "right" "Good job.")
  ))
)

(function startBob()
  (if (== PLAYCOUNTS.B 0)
  (
    (line "left" "Hoo boy, the Moon Maze. Those suckers like to hide in the moons.")
    (line "right" "That follows their standard strategy. You'll have access to " NAMES.tankRocket " tanks for that reason.")
    (line "left" "Ahh I guess that fits. Not my usual style but doesn't mean I can't launch some " NAMES.tankGauss " too.")
    (line "right" "You're free to defend the planet however you see fit.")
    (line "left" "Then let's get this party started! We've got appointment with " C.name ".")

    (startLevel)
    (line "right" "...")
  )
  ( ; Else
    (line "left" "Okay I think I've gotten the hang of these rockets!")
    (line "right" "That's good!")

    (startLevel)
  ))
)

(function endBob ()
  (if (== PLAYCOUNTS.B 0)
  (
    (line "left" "Hee haw!")
    (line "right" "Good job.")
  )
  ( ; Else
    (line "left" "Hee haw!")
    (line "right" "Good job.")
  ))
)

(function startCaesar()
  (line "left" "As I recall there used to be more facilities on this moon.")
  (line "right" "That was a long time ago, I'm surprised you knew that.")
  (line "left" "My research clearance does give me access to the archives.")
  (line "right" "I shouldn't be surprise that you'd take advantage of that access.")
  (line "left" "As the " NAMES.tankRocket " was developed on " NAMES.drewe ", I expect that it should be well suited to defending it.")
  (line "right" "Correct, I don't expect you to have too many issues, but always be on your guard.")

  (startLevel)
)

(function endCaesar ()
  (line "right" "Good job " C.name ".")
  (line "left" "I must assume that you did not read report C014?")
  (line "right" "I've made sure to skim all your reports... but you might have to remind about that one.")
  (line "left" "I actually did not check the research archive to find out about this place.")
  (line "right" "Hmm I was thinking that I should check what is in the archive after you mentioned it's presence.")
  (line "left" "We had reached the point where we wanted to test the " NAMES.chronodome " at a location outside of the lab.")
  (line "left" "The location I had chosen on " NAMES.drewe " was near a mountain range close to the equator and about 100 years ago.")
  (line "left" "When the probe arrived, inside of a building, we confirmed that our new world and temporary coordinates were correct.")
  (line "left" "We realised that there was now a chance of affecting the timeline, also we did not want a probe in a seemingly top-secret facility.")
  (line "right" "So you accidentally time-travelled to a top secret weapons facility from the past?")
  (line "left" "Correct, so during the formal report I tweaked the coordinates to a location that would not reveal that we knew of the facility.")
  (line "right" "...")
  (line "right" "Well this could be a coincidence, but some of the initial concepts for what become the " NAMES.chronodome " project came from there.")
  (line "left" "I don't think I like what you're implying here, that the creation of the " NAMES.chronodome " is somehow a time-loop?")
  (line "right" "I think it's best that we don't interfere anymore lest the universe gets angry.")
  (line "left" "A colourful description, but I think in this case I must agree.")
)

(register "start" levelStart)
(register "end" levelEnd)